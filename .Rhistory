predict(sm1, qnorm(c(.975, .5, .025)))[["y"]]
plot(sm1$y, sm1$x, type = "l", main = "Radice con segno del log-RV",
xlab = expression(beta[paste(5, ",", i)]), ylab = expression(r[P](beta[paste(5, ",", i)])))
abline(h = qnorm(c(0.025, 0.975)), lty = 3)
