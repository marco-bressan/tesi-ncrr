ll <- mapply(function(t, m, Si, Gi) {
Ci <- chol(Si + Gi)
Ci <- mvtnorm::ltMatrices(Ci[which(upper.tri(Ci, diag = TRUE))],
diag = TRUE)
mvtnorm::ldmvnorm(t, mean = m, chol = Ci)
}, y, mu, Sigma, Gamma)
